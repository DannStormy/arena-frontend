# Production build config (used by `vite build`, i.e. Render's static-site build).
# NOT secret — these are just the public API origin. Dev is unaffected: `yarn dev`
# runs in development mode and uses .env.local instead.
#
# If your Render API service ends up on a different URL than the predicted one
# below, edit both lines and redeploy the frontend.
#
#   VITE_API_BASE_URL     → includes the /api/v1 prefix (axios baseURL)
#   VITE_API_BASE_URL_WS  → bare origin, NO /api/v1 (socket.io namespace is /duels)
VITE_API_BASE_URL=https://arena-api-7gye.onrender.com/api/v1
VITE_API_BASE_URL_WS=https://arena-api-7gye.onrender.com
